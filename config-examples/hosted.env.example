# oncellclaw — hosted / headless configuration (.env keys)
#
# These are the keys for running oncellclaw as a supervised service with the
# built-in `web` channel as its front door: what scripts/cloud-start.sh reads,
# and what oncell.ai/dashboard/claw sets for you when it provisions your cell.
#
# Copy the keys you need into the repo-root `.env`, or export them in the
# service environment. Every one of them is also read from process.env, which
# is what the hosted path uses — no secret is ever written to disk there.
#
# For the OnCell runtime keys themselves see oncell.env.example.
# For the full narrative see README → "Hosted (how it works)".

# ── web channel ────────────────────────────────────────────────────────────
# Bearer token required on every /web/... request:
#   Authorization: Bearer <token>
# REQUIRED. The web channel refuses to start without it — a hosted instance's
# URL is public, and this token is the only boundary between the internet and
# your assistant. Generate one with: openssl rand -hex 32
ONCELLCLAW_WEB_TOKEN=

# Escape hatch for local development ONLY: run the web channel with no
# authentication at all. Never set this on anything reachable from a network
# you don't control.
#ONCELLCLAW_WEB_ALLOW_INSECURE=1

# Rate limits (both answer 429 {"error":"rate_limited"} + Retry-After when
# exceeded; GET polls and /health are never limited):
#
# Failed auth attempts one client IP may make per minute before /web/...
# starts refusing it — checked BEFORE the token compare, so a brute-forcer
# who has burned the budget never reaches the comparison. Sliding window.
#ONCELLCLAW_WEB_AUTH_FAILURES_PER_MIN=20
#
# Message POSTs one group accepts per minute. Token bucket: a real
# conversation can burst up to this number, sustained throughput is capped
# at it. Protects the agent behind the group if the token ever leaks.
#ONCELLCLAW_WEB_MESSAGES_PER_MIN=30

# HTTP listen port for the one server the process opens (webhooks + web
# channel + /health). On hosted runs the cell supervisor always sets this —
# don't pin it there. The 3000 fallback is for bare self-hosting only.
# WEBHOOK_PORT still takes precedence, so existing installs are unaffected.
#PORT=3000

# ── bootstrap (scripts/cloud-start.sh) ─────────────────────────────────────
# Agent group to provision on first run, and the URL slug it answers on:
#   POST /web/<group>/message   GET /web/<group>/messages
#ONCELLCLAW_GROUP=assistant

# Standing instructions for that group. Staged once as the group's persona
# (groups/<group>/instructions.prepend.md) and never overwritten afterwards,
# so an assistant that has been re-instructed in place keeps its edits.
#ONCELLCLAW_PERSONA=You are a terse, no-nonsense assistant.

# Which code to run. The bootstrap is node-only (cells have no git/curl):
# the ref is resolved to a commit sha via the GitHub API and the source
# arrives as a codeload tarball, extracted to $ONCELLCLAW_DIR/src-<sha>
# with a `current` symlink flipped atomically. A full 40-hex sha as the ref
# skips resolution and warm-restarts fully offline. ONCELLCLAW_REPO must be
# a github.com URL.
#ONCELLCLAW_REPO=https://github.com/anupsinghinfra/oncellclaw.git
#ONCELLCLAW_REF=main

# Persistent base directory. Durable state lives in $ONCELLCLAW_DIR/state
# (data/, groups/, store/, .env — symlinked into every checkout) and
# survives every update; src-<sha> trees are immutable and disposable.
#ONCELLCLAW_DIR=$HOME/oncellclaw

# Agent credential — exactly one of these is required.
#ANTHROPIC_API_KEY=sk-ant-...
#CLAUDE_CODE_OAUTH_TOKEN=...
