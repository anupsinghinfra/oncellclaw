# oncellclaw — OnCell runtime configuration (.env keys)
#
# Copy the keys you need into the repo-root `.env`. With ONCELL_API_KEY set,
# agents run in durable OnCell cells (one cell per agent group, named
# clawg-{namespace}-{group-folder}; namespace = ONCELLCLAW_CELL_NAMESPACE,
# default = this install's slug). Without it, everything runs locally on
# Docker, exactly like upstream NanoClaw.
#
# Selection matrix (src/runtime-select.ts):
#   ONCELLCLAW_RUNTIME=docker  -> docker, even if a key is set
#   ONCELLCLAW_RUNTIME=oncell  -> oncell (startup fails fast without a key)
#   key set, no override       -> oncell
#   nothing set                -> docker

# Required for the OnCell runtime. Get one at https://oncell.ai
ONCELL_API_KEY=oncell_sk_...

# Optional: override the API endpoint (defaults to https://api.oncell.ai)
#ONCELL_API_URL=https://api.oncell.ai

# Optional: force a runtime instead of key-based auto-selection
#ONCELLCLAW_RUNTIME=oncell

# Optional: cell namespace isolating this instance's agent-group cells from
# other oncellclaw instances in the same OnCell account (kebab-case, <=24
# chars). Defaults to the install slug — set explicitly when several
# instances share one account (the hosted dashboard always sets it).
#ONCELLCLAW_CELL_NAMESPACE=my-claw

# Agent credentials are forwarded to the cell ONLY via the service
# environment at start — never written into cell files. Whichever of these
# already exists in .env is forwarded as-is:
#   ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN / ANTHROPIC_AUTH_TOKEN
#   ANTHROPIC_BASE_URL

# Running oncellclaw itself as a hosted/headless service (the `web` channel,
# PORT, and the scripts/cloud-start.sh bootstrap)? See hosted.env.example.
